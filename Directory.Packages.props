<Project>
  <!--
    Central Package Management: the single place where NuGet package versions are declared.
    Project files reference packages without a Version attribute.
    Keep the list alphabetical; add a package here first, then reference it in the project.
  -->
  <!-- Lets a PackageVersion below also override a vulnerable transitive dependency. -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- Transitive pin: Microsoft.Data.SqlClient 6.1.7 (via EF Core SqlServer 10.0.14) pulls 9.0.11,
         affected by GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Remove once EF Core ships a patched SqlClient. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>